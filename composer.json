{
  "name": "milpa/auth-webauthn",
  "description": "Passkey / WebAuthn adapter for the Milpa PHP framework: the lbuchs/webauthn implementation of milpa/auth's WebAuthnVerifier, plus in-memory challenge and credential stores. Ceremony types and contracts live in milpa/auth. A verified assertion mints a session \u2014 it is never a per-request transport. Zero framework, zero ORM.",
  "keywords": [
    "php",
    "milpa",
    "framework",
    "webauthn",
    "passkeys",
    "fido2",
    "authentication",
    "security"
  ],
  "type": "library",
  "license": "Apache-2.0",
  "authors": [
    {
      "name": "Rodrigo Vicente - TeamX Agency",
      "homepage": "https://x.com/rodrigoteamx"
    }
  ],
  "require": {
    "php": ">=8.3",
    "milpa/auth": "^0.9",
    "lbuchs/webauthn": "^2",
    "psr/http-message": "^1 || ^2",
    "ext-openssl": "*",
    "ext-mbstring": "*",
    "ext-sodium": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpdoc-parser": "^2.3",
    "friendsofphp/php-cs-fixer": "^3.65",
    "milpa/core": "*"
  },
  "autoload": {
    "psr-4": {
      "Milpa\\Auth\\WebAuthn\\Adapter\\": "src/Adapter/"
    },
    "classmap": [
      "src/InMemoryChallengeStore.php",
      "src/InMemoryWebAuthnCredentialStore.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Milpa\\Auth\\WebAuthn\\Tests\\": "tests/",
      "Milpa\\Docs\\": "vendor/milpa/core/tools/gen-docs/"
    }
  }
}
